  "training": {
    "epochs": 1000,
    "lr": 0.01,
    "contrast_dim": 8,
    "temperature": 0.07,
    "lambda_cca": 220.0,
    "lambda_con": 0.009,
    "lambda_snp": 0.08,
    "lambda_img": 0.02,
    "lambda_reg": 1e-12
  },
  "downstream": {
    "tune": false,
    "use_frozen": true,
    "inner_folds": 5
  },
  "tasks": [
    "classification"
  ]
