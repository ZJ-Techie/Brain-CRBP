{
  "name": "snp_protein",
  "modality": "protein",
  "protocol": "holdout",
  "test_size": 0.2,
  "seeds": [
    20260907,
    20260908,
    20260909
  ],
  "top_k": 10,
  "upstream": "all",
  "standardize": {
    "snp": true,
    "img": true,
    "scope": "all"
  },
  "association": false,
  "priors": {
